[node name="Intro" type="Label" parent="Controls"]
layout_mode = 0
offset_left = 357.0
offset_top = 109.0
offset_right = 1100.0
offset_bottom = 976.0
theme_override_font_sizes/font_size = 40
text = "Meet Aria, she once stood at the pinnacle of the idol world. But everything changed in one catastrophic moment. Both her legs were severely damaged in a tragic accident, leaving her body frail and her mobility forever compromised. 

Now, Aria is trapped in a mental loop: dreams of glory play on repeat, warped by doubt and pain. Help her navigate this decaying dreamscape and find the strength to reclaim herself — not as who she was, but who she could become."
autowrap_mode = 2

